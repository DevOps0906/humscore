# 비워 두면 로컬 저장 모드로 동작합니다 (로그인 없이 MVP 테스트 가능)
# 값을 넣으면 로그인 사용자 악보가 Supabase에도 동기화됩니다. 보안은 RLS로 지킵니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 이메일 코드 입력 로그인: Supabase Auth > Email Templates(Magic Link)에 {{ .Token }} 포함.
# Auth > URL Configuration 의 Redirect URLs 에 <도메인>/auth/callback 추가 (Google OAuth 포함).

# 체험(mock) 자동 로그인 — 기본 켜짐. 0 이면 끄고 실제 Supabase 로그인·동기화 사용
NEXT_PUBLIC_AUTH_MOCK=
